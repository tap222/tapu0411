# PokéAPI Public GraphQL Endpoint
POKEAPI_GRAPHQL_URL=https://beta.pokeapi.co/graphql/v1beta

# Backend Microservice Configuration (TypeORM + SQLite + GraphQL)
BACKEND_PORT=4000
BACKEND_GRAPHQL_URL=http://localhost:4000/graphql

# Security & JWT Token Secrets
JWT_SECRET=super_secret_pokedex_jwt_key_2026
JWT_EXPIRES_IN=24h

# Multi-Tier Caching & Resilience
CACHE_TTL_MS=600000
REQUEST_TIMEOUT_MS=30000
IMAGE_CACHE_DURATION_MS=600000
IMAGE_CACHE_MAX_RETRIES=3
IMAGE_CACHE_RETRY_DELAY_MS=1000

# Pokédex Pagination & Virtual Scroll
DEFAULT_PAGE_SIZE=25
