{
  "name": "mini-pokedex",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "ng": "ng",
    "env": "node scripts/set-env.js",
    "prestart": "node scripts/set-env.js",
    "start": "ng serve --port 4200",
    "backend": "tsx --tsconfig server/tsconfig.json server/src/index.ts",
    "dev": "concurrently -n \"BACKEND,CLIENT\" -c \"magenta,cyan\" \"npm run backend\" \"npm run start\"",
    "prebuild": "node scripts/set-env.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "echarts": "^5.6.0",
    "express": "^4.21.2",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.10.9",
    "jsonwebtoken": "^9.0.2",
    "ngx-echarts": "^21.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
